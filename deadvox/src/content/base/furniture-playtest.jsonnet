local plaque(id, name, color, readable) = {
  id: id,
  name: name,
  size: [1, 1, 1],
  color: color,
  mount: 'wall',
  solid: false,
  shape: [{ position: [0, 0, 0.875], size: [1, 1, 0.125] }],
  readable: readable,
};
