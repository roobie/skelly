local box(position, size, color) = { position: position, size: size, color: color };
local scaled(parts, size) = [part + {
  position: [part.position[axis] * size[axis] for axis in std.range(0, 2)],
  size: [part.size[axis] * size[axis] for axis in std.range(0, 2)],
} for part in parts];
local carcass(p) = [
  box([0.04, 0, 0.08], [0.92, 0.065, 0.86], p.shadow),
  box([0, 0.065, 0.08], [0.065, 0.89, 0.92], p.shell),
