// The JavaScript no workspace program checks.
// It extends deadvox's options because the workspace TypeScript it imports type-checks only
// under the options that TypeScript is written for.
{
  "extends": "./packages/deadvox/tsconfig.json",
  "compilerOptions": {
    // These files run on Node 22 or later, which ships the ES2024 library.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // The site ships unbundled and loads lit-html from the CDN; the lockfile pins the same version.
    "paths": {
      "https://cdn.jsdelivr.net/npm/lit-html@3.3.3/+esm": ["./node_modules/lit-html/lit-html.d.ts"]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "tools",
    "test",
    "site",
    "packages/deadvox/src/bench/*.mjs",
    "packages/deadvox/tools",
    "packages/deadvox/playtests",
    "packages/deadvox/test/*.mjs",
    "packages/deadvox/test/fixtures/*.mjs",
    "packages/engine/tools",
    "packages/presentation/tools"
  ],
  // The actors contract test imports skelly-assets kinematics, which does not type-check under
  // these options; its fix belongs in the skelly-assets submodule. The building sheet tool drives page
  // code, so the browser stages' program checks it.
  "exclude": [
    "tools/lit-check",
    "tools/.build",
    "test/actors-deadvox-contract.test.mjs",
    "packages/deadvox/tools/building-sheet.mjs"
  ]
}
