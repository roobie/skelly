// Repo-wide lint and format config. Pillar (PILLARS.md): as much static analysis and
// as strict formatting as the tools allow. Every stable rule is on as an error; each
// opt-out below says why. Nursery (unstable) rules are left out.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The submodule's thing-core is a root workspace, so it is indexed for import resolution.
    "includes": [
      "**",
      "!**/dist",
      "!**/package-lock.json",
      "!**/__snapshots__",
      "!packages/deadvox/vendor/rapier-f64",
      "!packages/skelly-assets/*",
      "packages/skelly-assets/tools",
      "!packages/skelly-assets/tools/*",
      "packages/skelly-assets/tools/packages",
      "!packages/skelly-assets/tools/packages/*",
      "packages/skelly-assets/tools/packages/thing-core"
    ]
  },
  // The submodule owns its checks; parent rules must not relint another repository.
  "formatter": {
    "includes": ["**", "!packages/skelly-assets/**"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "includes": ["**", "!packages/skelly-assets/**"], "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "includes": ["**", "!packages/skelly-assets/**"],
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    },
    "domains": {
      // Module-graph rules (unresolved imports, import cycles…) and test-framework rules.
      "project": "all",
      "test": "all",
      // Frameworks we don't use: their rules only misfire.
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "vue": "none"
    }
  },
  "overrides": [
    {
      // Opt-outs. A group set to "error" above can't also list rules, so they live here.
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": {
            // Shared Tiled/runtime ES modules have .d.mts type bridges, but execute as .mjs.
            "useImportExtensions": { "level": "error", "options": { "extensionMappings": { "mts": "mjs" } } }
          },
          "complexity": {
            // noExcessiveCognitiveComplexity (on) measures what matters; raw length doesn't.
            "noExcessiveLinesPerFunction": "off"
          },
          "security": {
            // Entropy-based: flags CSS selectors and HTML strings. There are no secrets here.
            "noSecrets": "off"
          },
          "style": {
            // Early `continue` keeps voxel loops flat; banning it adds nesting.
            "noContinue": "off",
            "noExcessiveLinesPerFile": "off",
            // Geometry, colours and tuning constants are numbers by nature.
            "noMagicNumbers": "off",
            "noHexColors": "off",
            // tsconfig's noUncheckedIndexedAccess makes every index read `T | undefined`;
            // `!` is the explicit, reviewed acknowledgement on hot typed-array reads.
            "noNonNullAssertion": "off",
            // Single-level ternaries are fine; noNestedTernary (on) catches the unreadable ones.
            "noTernary": "off",
            // Helpers are defined next to their use, not hoisted above all exports.
            "useExportsLast": "off",
            "noIncrementDecrement": { "level": "error", "options": { "allowForLoopAfterthoughts": true } },
            "useNamingConvention": {
              "level": "error",
              "options": {
                // Allow acronyms like mulMV. Size-class keys S/M/L are CONSTANT_CASE.
                "strictCase": false,
                "conventions": [
                  { "selector": { "kind": "objectLiteralProperty" }, "formats": ["camelCase", "CONSTANT_CASE"] }
                ]
              }
            }
          },
          "suspicious": {
            // Voxel coordinates and hashing are bit arithmetic.
            "noBitwiseOperators": "off",
            // Type inference is not reliable yet: it reported RegExp#exec (nullable) as always
            // truthy, and only when run on its own. Revisit on Biome upgrades.
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // Tiled 1.11 supplies these globals; Qt 5's ES6 engine cannot parse object spread.
      "includes": ["packages/deadvox/maps/extensions/*.mjs"],
      "javascript": { "globals": ["FileInfo", "tiled", "TextFile", "TileMap", "MapObject"] },
      "linter": { "rules": { "style": { "useObjectSpread": "off" } } }
    },
    {
      // Node stays in CLIs, their file-writing adapters, tests and build config; game/core code stays browser-pure.
      "includes": [
        "**/src/cli/**",
        "**/test/**",
        "**/vite.config.ts",
        "testPool.ts",
        "tools/jsonnet/**",
        "tools/skelly-assets/**",
        "tools/pinned-download.mjs",
        "packages/deadvox/tools/publish-playtest.mjs",
        "packages/deadvox/tools/police-item-models.mjs",
        "packages/deadvox/tools/item-fuel-models.mjs",
        "tools/item-model-metadata.mjs",
        "tools/addPagesAnalytics.mjs",
        "pagesAnalyticsPlugin.ts",
        "packages/deadvox/tools/perf-baseline.mjs",
        "packages/deadvox/tools/perf-baseline.test.mjs",
        "packages/deadvox/tools/perf-baseline-trace.mjs",
        "packages/deadvox/tools/rapier-f64/local.mjs"
      ],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    },
    {
      // Standalone Node benchmarks import game systems and print measured timings.
      "includes": ["**/src/bench/*-cpu.mjs", "**/deadvox/tools/bench-zombie-swings.mjs"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["packages/deadvox/tools/perf-baseline.mjs", "packages/deadvox/tools/perf-baseline-trace.mjs"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" }, "performance": { "noAwaitInLoops": "off" } } }
    },
    {
      // CLIs talk to the terminal.
      "includes": ["**/src/cli/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Vite and Vitest require a default export.
      "includes": ["**/vite.config.ts", "**/vitest.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // Deadvox and presentation tests reach package internals through the test-only subpaths, whose export
      // condition Biome's resolver does not apply. tsc applies it (each package's tsconfig.json, customConditions)
      // and resolves every import in these files, so an unresolved one still fails the typecheck.
      "includes": ["packages/deadvox/test/**/*.ts", "packages/presentation/test/**/*.ts"],
      "linter": { "rules": { "correctness": { "noUnresolvedImports": "off" } } }
    },
    {
      // The posing hot path runs once per bone per actor per frame. Profiling found
      // real time (V8's ArrayIteratorPrototypeNext) from destructuring a plain array here instead of
      // indexing it directly — a measured, deliberate choice at each of these call sites, not an
      // oversight useDestructuring should keep flagging.
      "includes": ["packages/engine/src/core/pose.ts", "packages/presentation/src/render/crowd.ts"],
      "linter": { "rules": { "style": { "useDestructuring": "off" } } }
    },
    {
      // The runtime and presentation packages' curated entries are re-export modules by design: other packages
      // reach them only through these. See `docs/decisions/0009-content-defined-products.md`, "Package boundaries".
      "includes": ["packages/engine/src/*.ts", "packages/engine/src/*.mjs", "packages/presentation/src/*.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      // The runtime's no-DOM typecheck (packages/engine/tsconfig.json) keeps Node types, which declare
      // navigator, MessageEvent, localStorage and sessionStorage, so the typecheck alone lets them through.
      // It also never reads JavaScript runtime files (packages/engine/src/core/authoredTerrain.mjs), so
      // document, window and requestAnimationFrame are banned here too. The path is the runtime source that
      // tsconfig includes. `event` and `error` keep the rule's default ban.
      "includes": ["packages/engine/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "event": "Use the event your handler receives, not the global one.",
                  "error": "Use a local variable, not the global error.",
                  "navigator": "Runtime code runs without the browser; take what you need from navigator as an argument.",
                  "MessageEvent": "Runtime code runs without the browser; MessageEvent is a browser type.",
                  "localStorage": "Runtime code runs without the browser; take storage as an argument instead.",
                  "sessionStorage": "Runtime code runs without the browser; take storage as an argument instead.",
                  "document": "Runtime code runs without the browser; there is no document.",
                  "window": "Runtime code runs without the browser; use globalThis or take the value as an argument.",
                  "requestAnimationFrame": "Runtime code runs without the browser; the caller owns the frame loop."
                }
              }
            }
          }
        }
      }
    }
  ]
}
