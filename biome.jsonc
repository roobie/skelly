// Repo-wide lint and format config. Pillar (README.md): as much static analysis and
// as strict formatting as the tools allow. Every stable rule is on as an error; each
// opt-out below says why. Nursery (unstable) rules are left out.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/dist", "!**/package-lock.json", "!**/__snapshots__"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    },
    "domains": {
      // Module-graph rules (unresolved imports, import cycles…) and test-framework rules.
      "project": "all",
      "test": "all",
      // Frameworks we don't use: their rules only misfire.
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "vue": "none"
    }
  },
  "overrides": [
    {
      // Opt-outs. A group set to "error" above can't also list rules, so they live here.
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": {
            // Shared Tiled/runtime ES modules have .d.mts type bridges, but execute as .mjs.
            "useImportExtensions": { "level": "error", "options": { "extensionMappings": { "mts": "mjs" } } }
          },
          "complexity": {
            // noExcessiveCognitiveComplexity (on) measures what matters; raw length doesn't.
            "noExcessiveLinesPerFunction": "off"
          },
          "security": {
            // Entropy-based: flags CSS selectors and HTML strings. There are no secrets here.
            "noSecrets": "off"
          },
          "style": {
            // Early `continue` keeps voxel loops flat; banning it adds nesting.
            "noContinue": "off",
            "noExcessiveLinesPerFile": "off",
            // Geometry, colours and tuning constants are numbers by nature.
            "noMagicNumbers": "off",
            "noHexColors": "off",
            // tsconfig's noUncheckedIndexedAccess makes every index read `T | undefined`;
            // `!` is the explicit, reviewed acknowledgement on hot typed-array reads.
            "noNonNullAssertion": "off",
            // Single-level ternaries are fine; noNestedTernary (on) catches the unreadable ones.
            "noTernary": "off",
            // Helpers are defined next to their use, not hoisted above all exports.
            "useExportsLast": "off",
            "noIncrementDecrement": { "level": "error", "options": { "allowForLoopAfterthoughts": true } },
            "useNamingConvention": {
              "level": "error",
              "options": {
                // Allow acronyms like mulMV. Size-class keys S/M/L are CONSTANT_CASE.
                "strictCase": false,
                "conventions": [
                  { "selector": { "kind": "objectLiteralProperty" }, "formats": ["camelCase", "CONSTANT_CASE"] }
                ]
              }
            }
          },
          "suspicious": {
            // Voxel coordinates and hashing are bit arithmetic.
            "noBitwiseOperators": "off",
            // Type inference is not reliable yet: it reported RegExp#exec (nullable) as always
            // truthy, and only when run on its own. Revisit on Biome upgrades.
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // Tiled 1.11 supplies these globals; Qt 5's ES6 engine cannot parse object spread.
      "includes": ["deadvox/maps/extensions/*.mjs"],
      "javascript": { "globals": ["FileInfo", "tiled", "TextFile", "TileMap", "MapObject"] },
      "linter": { "rules": { "style": { "useObjectSpread": "off" } } }
    },
    {
      // Node is allowed only in CLIs, tests and build config; game/core code stays browser-pure.
      "includes": ["**/src/cli/**", "**/test/**", "**/vite.config.ts", "testPool.ts"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    },
    {
      // Standalone Node benchmarks import game systems and print measured timings.
      "includes": ["**/src/bench/shamblers-cpu.mjs", "**/deadvox/tools/bench-zombie-swings.mjs"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Standalone Playwright check scripts (run by hand, not by vitest): they assert, read env and print.
      "includes": ["**/gungen/test/browser/*.mjs"],
      "linter": {
        "rules": {
          "correctness": { "noProcessGlobal": "off" },
          "style": { "noProcessEnv": "off" },
          "suspicious": { "noConsole": "off", "noMisplacedAssertion": "off" }
        }
      }
    },
    {
      // CLIs talk to the terminal.
      "includes": ["**/src/cli/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Vite requires a default export.
      "includes": ["**/vite.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // mobgen's posing hot path (CHALLENGES.md §1: once per bone per actor per frame). Profiling found
      // real time (V8's ArrayIteratorPrototypeNext) from destructuring a plain array here instead of
      // indexing it directly — a measured, deliberate choice at each of these call sites, not an
      // oversight useDestructuring should keep flagging.
      "includes": [
        "**/mobgen/src/core/pose.ts",
        "**/mobgen/src/viewer/stressActors.ts",
        "**/mobgen/src/cli/bench.ts",
        "**/mobgen/src/mob/crowd.ts"
      ],
      "linter": { "rules": { "style": { "useDestructuring": "off" } } }
    },
    {
      // deadvox reuses mobgen's pure src/core and src/mob via a `@mobgen/*` path alias (vite.config.ts's
      // resolve.alias, tsconfig.json's paths) rather than an npm dependency — mobgen has no package.json
      // entry and isn't published, so there's nothing to "add to the manifest". Biome's dependency check
      // doesn't follow bundler/tsconfig path aliases, so it reads every `@mobgen/...` specifier as an
      // undeclared npm package; these simulation/rendering and test files deliberately use that alias.
      "includes": [
        "**/deadvox/src/render/mobActors.ts",
        "**/deadvox/src/core/zombies.ts",
        "**/deadvox/src/core/zombieRegions.ts",
        "**/deadvox/src/core/zombiePose.ts",
        "**/deadvox/test/mobActors.test.ts",
        "**/deadvox/test/zombieRegions.test.ts"
      ],
      "linter": { "rules": { "correctness": { "noUndeclaredDependencies": "off" } } }
    }
  ]
}
