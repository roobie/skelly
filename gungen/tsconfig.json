{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // Mirrors Deadvox's @mobgen/* source alias; tsc does not read Vite's resolve.alias.
    "paths": { "@mobgen/*": ["../packages/mobgen/src/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true
  },
  // Deadvox's jfxr declaration, shared because gungen tests import the registry that reaches soundSynth.ts.
  "include": ["src", "test", "vite.config.ts", "../packages/deadvox/src/core/jfxr.d.ts"]
}
