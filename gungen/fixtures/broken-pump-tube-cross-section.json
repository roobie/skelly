{
  "name": "broken-pump-tube-cross-section",
  "description": "Pump shotgun whose explicit tube cross-section disagrees with its octagonal barrel.",
  "expect": ["tube-cross-section-match"],
  "root": "receiver",
  "parts": {
    "receiver": { "family": "receiver", "params": { "action": "pump", "feed": "tube", "bore": "M" } },
    "lower": { "family": "lower", "params": { "layout": "trigger" } },
    "barrel": { "family": "barrel", "params": { "length": "M", "crossSection": "octagonal" } },
    "tube": { "family": "tube-magazine", "params": { "lengthPercent": "75", "crossSection": "square" } },
    "forend": { "family": "forend" },
    "stock": { "family": "stock", "params": { "length": "M", "style": "sporting" } }
  },
  "connections": [
    { "from": "receiver.lower", "to": "lower.top" },
    { "from": "receiver.barrel", "to": "barrel.rear" },
    { "from": "receiver.tube", "to": "tube.rear" },
    { "from": "tube.cap", "to": "barrel.lug" },
    { "from": "tube.support", "to": "barrel.support-lug" },
    { "from": "tube.forend", "to": "forend.rear" },
    { "from": "receiver.stock", "to": "stock.front" }
  ]
}
