{
  "name": "archetype-smg",
  "description": "Submachine gun: rifle layout at small bore, with a short barrel, short stock and long magazine.",
  "expect": [],
  "root": "receiver",
  "parts": {
    "receiver": { "family": "receiver", "params": { "action": "auto", "feed": "box", "bore": "S" } },
    "lower": { "family": "lower", "params": { "layout": "conventional" } },
    "barrel": { "family": "barrel", "params": { "bore": "S", "length": "S" } },
    "handguard": { "family": "handguard", "params": { "length": "S", "inner": "M" } },
    "grip": { "family": "grip", "params": { "length": "M" } },
    "magazine": { "family": "magazine", "params": { "length": "L" } },
    "stock": { "family": "stock", "params": { "length": "S", "style": "straight" } },
    "sight": { "family": "sight" }
  },
  "connections": [
    { "from": "receiver.lower", "to": "lower.top" },
    { "from": "receiver.barrel", "to": "barrel.rear" },
    { "from": "receiver.handguard", "to": "handguard.rear" },
    { "from": "handguard.front", "to": "barrel.clamp" },
    { "from": "lower.grip", "to": "grip.top" },
    { "from": "lower.magazine", "to": "magazine.top" },
    { "from": "receiver.stock", "to": "stock.front" },
    { "from": "receiver.rail", "slot": 0, "to": "sight.base" }
  ]
}
