{
  "name": "archetype-battle-rifle",
  "description": "FAL/FNC-like battle rifle, conventional layout: magazine ahead of the pistol grip, straight stock, handguard clamped to the barrel.",
  "expect": [],
  "root": "receiver",
  "parts": {
    "receiver": { "family": "receiver", "params": { "action": "auto", "feed": "box", "bore": "M" } },
    "bolt-carrier": { "family": "bolt-carrier", "params": { "pattern": "barrett", "handleStyle": "battle" } },
    "lower": { "family": "lower", "params": { "layout": "conventional" } },
    "barrel": { "family": "barrel", "params": { "length": "M" } },
    "handguard": { "family": "handguard", "params": {} },
    "grip": { "family": "grip", "params": { "length": "M" } },
    "magazine": { "family": "magazine", "params": { "length": "M" } },
    "stock": { "family": "stock", "params": { "length": "M", "style": "straight" } },
    "sight": { "family": "sight", "params": { "type": "fixed-prism-4x" } }
  },
  "connections": [
    { "from": "receiver.lower", "to": "lower.top" },
    { "from": "receiver.barrel", "to": "barrel.rear" },
    { "from": "receiver.bolt-carrier", "to": "bolt-carrier.mount" },
    { "from": "receiver.handguard", "to": "handguard.rear" },
    { "from": "handguard.front", "to": "barrel.clamp" },
    { "from": "lower.grip", "to": "grip.top" },
    { "from": "lower.magazine", "to": "magazine.top" },
    { "from": "receiver.stock", "to": "stock.front" },
    { "from": "receiver.rail", "slot": 3, "to": "sight.base" }
  ]
}
