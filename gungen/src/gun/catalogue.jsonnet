// The closed gun-part catalogue. Every entry authors one mass. A row only selects that mass for the parts whose resolved
// params contain its `match`. An item also fixes its construction params and finish, so a design can name it and it
// exports as its own loose part; its `match` is the subset of those params that selects it for unconverted designs.
local appearance = import 'appearance.jsonnet';
local row(id, family, match, massKg) = { id: id, family: family, match: match, massKg: massKg };
local item(id, family, selector, params, massKg, profile) =
  row(id, family, { [key]: params[key] for key in selector }, massKg)
  + { params: params, finish: appearance.gun.profileFinishes[profile] };
