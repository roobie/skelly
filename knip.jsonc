{
  "$schema": "./node_modules/knip/schema.json",
  // Pipeline dependency checks belong to the submodule's own install and CI.
  "ignore": ["packages/skelly-assets/**"],
  "workspaces": {
    ".": {
      "entry": ["site/launcher.js!", "test/**/*.mjs", "testPool.ts", "tools/**/*.mjs"],
      "project": ["site/**/*.js!", "test/**/*.{js,mjs,ts,tsx}", "tools/**/*.{js,mjs,ts,tsx}"]
    },
    "packages/deadvox": {
      "ignore": ["vendor/rapier-f64/**"],
      // The measurement tool substitutes this package into the Rapier seam through a Vite transform.
      "ignoreDependencies": ["@dimforge/rapier3d-compat"],
      "ignoreBinaries": [
        // Local publication uses the operator's mise-managed, authenticated Surge CLI.
        "mise",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xwininfo",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xprop"
      ],
      "ignoreUnresolved": [
        // Vite resolves this browser URL from the Deadvox root at runtime.
        "/src/presentation/saveStorage.ts",
        "/src/product/input.ts",
        "/src/presentation/controls.ts",
        "/src/presentation/guidedSteps.ts",
        "/src/ui/guidedSteps.ts",
        "/src/core/inventory.ts",
        "/src/core/handling.ts",
        "/src/game/unpacking.ts",
        "/src/game/firearmHandling.ts",
        "/src/ui/inventoryScreen.ts",
        "/src/core/reach.ts",
        "/src/core/stageMarks.ts",
        "/test/fixtures/capabilityIds.ts",
        "/src/core/character.ts",
        "/src/core/templates.ts",
        "/src/core/furnitureSurface.ts",
        "/src/game/session.ts",
        "/src/core/scenarioCertificate.ts",
        "/src/core/options.ts",
        "/src/game/doorAction.ts",
        "/src/core/ladders.ts",
        "/test/fixtures/descentLid.ts",
        "/test/fixtures/scenarioStart.ts",
        "/test/browser/sky-selection.ts",
        "/test/browser/interaction-marker-lighting.ts",
        "/test/browser/water-depth.ts",
        "/test/browser/gauntlet-doors.mjs",
        "/src/feasibility/runner.ts",
        "/tools/rapier-f64/candidate.ts"
      ],
      "entry": [
        "index.html!",
        "playtests/**/*.js!",
        "sounds.html!",
        "map.html!",
        "vehicle-spike.html!",
        // Vite dev-only pages are deliberately outside the production build inputs.
        "src/siteMapPage.ts!",
        "src/debug/vehicleSpike.ts!",
        "src/soundsPage.ts!",
        // A type-level witness compiled by typecheck, never imported.
        "src/worker/mesherPort.witness.ts",
        "tools/police-item-models.mjs",
        "tools/item-fuel-models.mjs",
        "tools/rapier-f64/candidate.ts",
        "tools/bench-zombie-swings.mjs",
        "tools/ui-browser-contract.mjs",
        "tools/perf-baseline.mjs",
        "tools/perf-baseline-browser.mjs"
      ],
      "project": [
        "src/**/*.{js,mjs,ts,tsx}!",
        "playtests/**/*.js!",
        "test/**/*.{js,mjs,ts,tsx}",
        "tools/**/*.{js,mjs,ts,tsx}"
      ]
    }
  }
}
