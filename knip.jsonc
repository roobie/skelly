{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  // Pipeline dependency checks belong to the submodule's own install and CI.
  "ignore": ["packages/skelly-assets/**"],
  "workspaces": {
    ".": {
      "entry": ["site/launcher.js!", "test/**/*.mjs", "testPool.ts", "tools/**/*.mjs"],
      "project": ["site/**/*.js!", "test/**/*.{js,mjs,ts,tsx}", "tools/**/*.{js,mjs,ts,tsx}"]
    },
    "packages/engine": {
      // The entries are the package's exports; the test-only subpath serves deadvox tests.
      "entry": ["src/*.ts!", "src/*.mjs!"],
      "project": ["src/**/*.{mjs,ts}!", "test/**/*.ts"]
    },
    "packages/presentation": {
      // The entries are the package's exports; the test-only subpath serves deadvox tests and stages.
      "entry": ["src/*.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/deadvox": {
      // The measurement tool substitutes this package into the Rapier seam through a Vite transform.
      "ignoreDependencies": ["@dimforge/rapier3d-compat"],
      "ignoreBinaries": [
        // Local publication uses the operator's mise-managed, authenticated Surge CLI.
        "mise",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xwininfo",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xprop"
      ],
      "ignoreUnresolved": [
        // The UI contract's page code imports the stage server's browser URLs; see `packages/deadvox/test/browser/stageServer.mjs`, `createStageServer`.
        // Knip resolves them through `packages/deadvox/test/browser/tsconfig.json`, `paths` only for stages in that directory, and the contract lives in tools.
        "/src/product/input.ts",
        "/src/product/assets.ts",
        "/src/product/content.ts",
        "/@stage/@skelly/engine/content",
        "/@stage/@skelly/engine/input",
        "/@stage/@skelly/engine/inventory",
        "/@stage/@skelly/engine/packs",
        "/@stage/@skelly/engine/sim",
        "/@stage/@skelly/presentation/audio",
        "/@stage/@skelly/presentation/internal/presentation/controls.ts",
        "/@stage/@skelly/presentation/internal/presentation/graphicsSettings.ts",
        "/@stage/@skelly/presentation/internal/ui/hud.ts",
        "/@stage/@skelly/presentation/ui"
      ],
      "entry": [
        "index.html!",
        "playtests/**/*.js!",
        "sounds.html!",
        "map.html!",
        // Vite dev-only pages are deliberately outside the production build inputs.
        "src/siteMapPage.ts!",
        "src/soundsPage.ts!",
        // Tiled loads the map extension, which takes the authored terrain evaluator from its runtime entry.
        "maps/extensions/*.mjs",
        "tools/police-item-models.mjs",
        "tools/item-fuel-models.mjs",
        "tools/rapier-f64/candidate.ts",
        "tools/bench-zombie-swings.mjs",
        "tools/ui-browser-contract.mjs",
        "tools/perf-baseline.mjs",
        "tools/perf-baseline-browser.mjs"
      ],
      "project": [
        "src/**/*.{js,mjs,ts,tsx}!",
        // The content validator CLI runs in CI and deploy checks, never in the game.
        "!src/cli/**!",
        // Node CPU benches and their world run from npm scripts, never in the game.
        "!src/bench/*.mjs!",
        "!src/bench/shamblerWorld.ts!",
        // The vehicle feasibility experiment is development-only; see `packages/deadvox/docs/vehicle-feasibility.md`.
        "!src/feasibility/**!",
        // The Rapier f64 seam has no product importer until physics integration lands; see `packages/deadvox/docs/vehicle-feasibility.md`, "Numeric eligibility and supply".
        "!src/core/rapier.ts!",
        "playtests/**/*.js!",
        "test/**/*.{js,mjs,ts,tsx}",
        "tools/**/*.{js,mjs,ts,tsx}"
      ]
    }
  }
}
