{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["site/launcher.js!", "test/**/*.mjs", "testPool.ts", "tools/**/*.mjs"],
      "project": ["site/**/*.js!", "test/**/*.{js,mjs,ts,tsx}", "tools/**/*.{js,mjs,ts,tsx}"]
    },
    "deadvox": {
      "ignoreBinaries": [
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xwininfo",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xprop"
      ],
      "ignoreUnresolved": [
        // Vite resolves this browser URL from the Deadvox root at runtime.
        "/src/game/saveStorage.ts"
      ],
      "entry": [
        "index.html!",
        "sounds.html!",
        "map.html!",
        "vehicle-spike.html!",
        // Vite dev-only pages are deliberately outside the production build inputs.
        "src/siteMapPage.ts!",
        "src/debug/vehicleSpike.ts!",
        "src/soundsPage.ts!",
        "tools/bench-rigid-body.mjs",
        "tools/bench-zombie-swings.mjs",
        "tools/ui-browser-contract.mjs"
      ],
      "project": ["src/**/*.{js,mjs,ts,tsx}!", "test/**/*.{js,mjs,ts,tsx}", "tools/**/*.{js,mjs,ts,tsx}"],
      "paths": {
        "@mobgen/*": ["../mobgen/src/*"]
      }
    },
    "gungen": {
      "entry": ["index.html!"],
      "project": ["src/**/*.{js,mjs,ts,tsx}!", "test/**/*.{js,mjs,ts,tsx}"]
    },
    "engine": {
      "project": ["src/**/*.{js,mjs,ts,tsx}!"],
      "paths": {
        "three": ["../gungen/node_modules/three"],
        "three/*": ["../gungen/node_modules/three/*"]
      }
    },
    "mobgen": {
      "entry": ["index.html!", "stress.html!", "src/viewer/stress.ts!"],
      "paths": {
        "@mobgen/*": ["src/*"]
      },
      "project": ["src/**/*.{js,mjs,ts,tsx}!", "test/**/*.{js,mjs,ts,tsx}"]
    }
  }
}
