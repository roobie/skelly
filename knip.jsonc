{
  "$schema": "./node_modules/knip/schema.json",
  // Pipeline dependency checks belong to the submodule's own install and CI.
  "ignore": ["packages/skelly-assets/**"],
  "workspaces": {
    ".": {
      "entry": ["site/launcher.js!", "test/**/*.mjs", "testPool.ts", "tools/**/*.mjs"],
      "project": ["site/**/*.js!", "test/**/*.{js,mjs,ts,tsx}", "tools/**/*.{js,mjs,ts,tsx}"]
    },
    "packages/engine": {
      // The entries are the package's exports; the test-only subpath serves deadvox tests.
      "entry": ["src/*.ts", "src/*.mjs"],
      "project": ["src/**/*.{mjs,ts}", "test/**/*.ts"]
    },
    "packages/presentation": {
      // The entries are the package's exports; the test-only subpath serves deadvox tests and stages.
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/deadvox": {
      // The measurement tool substitutes this package into the Rapier seam through a Vite transform.
      "ignoreDependencies": ["@dimforge/rapier3d-compat"],
      "ignoreBinaries": [
        // Local publication uses the operator's mise-managed, authenticated Surge CLI.
        "mise",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xwininfo",
        // OS dependency installed for Firefox's native-window probe; not a project package.
        "xprop"
      ],
      "ignoreUnresolved": [
        // Vite resolves this browser URL from the Deadvox root at runtime.
        "/src/product/input.ts",
        "/test/fixtures/capabilityIds.ts",
        "/test/fixtures/descentLid.ts",
        "/test/fixtures/scenarioStart.ts",
        "/test/browser/sky-selection.ts",
        "/test/browser/interaction-marker-lighting.ts",
        "/test/browser/water-depth.ts",
        "/test/browser/gauntlet-doors.mjs",
        "/test/fixtures/vehicleRapierReplay.ts",
        "/src/feasibility/runner.ts",
        "/tools/rapier-f64/candidate.ts",
        // A stage's dev server serves this browser URL as the game's own engine module; see `packages/deadvox/test/browser/stageServer.mjs`, `createStageServer`.
        "/@stage/@skelly/engine/internal/core/inventory.ts",
        "/@stage/@skelly/engine/internal/core/handling.ts",
        "/@stage/@skelly/engine/internal/core/reach.ts",
        "/@stage/@skelly/engine/internal/core/stageMarks.ts",
        "/@stage/@skelly/engine/internal/core/character.ts",
        "/@stage/@skelly/engine/internal/core/templates.ts",
        "/@stage/@skelly/engine/internal/core/furnitureSurface.ts",
        "/@stage/@skelly/engine/internal/core/scenarioCertificate.ts",
        "/@stage/@skelly/engine/internal/core/options.ts",
        "/@stage/@skelly/engine/internal/core/ladders.ts",
        "/@stage/@skelly/engine/internal/game/unpacking.ts",
        "/@stage/@skelly/engine/internal/game/firearmHandling.ts",
        "/@stage/@skelly/engine/internal/game/doorAction.ts",
        "/@stage/@skelly/engine/session",
        "/@stage/@skelly/presentation/internal/presentation/controls.ts",
        "/@stage/@skelly/presentation/internal/presentation/guidedSteps.ts",
        "/@stage/@skelly/presentation/internal/presentation/saveStorage.ts",
        "/@stage/@skelly/presentation/internal/ui/guidedSteps.ts",
        "/@stage/@skelly/presentation/internal/ui/inventoryScreen.ts"
      ],
      "entry": [
        "index.html!",
        "playtests/**/*.js!",
        "sounds.html!",
        "map.html!",
        "vehicle-spike.html!",
        // Vite dev-only pages are deliberately outside the production build inputs.
        "src/siteMapPage.ts!",
        "src/debug/vehicleSpike.ts!",
        "src/soundsPage.ts!",
        // Tiled loads the map extension, which takes the authored terrain evaluator from its runtime entry.
        "maps/extensions/*.mjs",
        "tools/police-item-models.mjs",
        "tools/item-fuel-models.mjs",
        "tools/rapier-f64/candidate.ts",
        "tools/bench-zombie-swings.mjs",
        "tools/ui-browser-contract.mjs",
        "tools/perf-baseline.mjs",
        "tools/perf-baseline-browser.mjs"
      ],
      "project": [
        "src/**/*.{js,mjs,ts,tsx}!",
        "playtests/**/*.js!",
        "test/**/*.{js,mjs,ts,tsx}",
        "tools/**/*.{js,mjs,ts,tsx}"
      ]
    }
  }
}
