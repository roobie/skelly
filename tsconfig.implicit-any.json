// The root program's directories whose files do not yet carry full JSDoc types, so implicit any
// stays allowed here. A directory moves to `tsconfig.json` once it checks without implicit any.
// A file the root program imports is checked there too, so it already needs full types.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false
  },
  "include": [
    "packages/deadvox/tools",
    "packages/deadvox/playtests",
    "packages/deadvox/test/*.mjs",
    "packages/deadvox/test/fixtures/*.mjs"
  ],
  // A hand-written declaration beside a module shadows it in an include pattern, so the module is named here.
  "files": ["packages/deadvox/tools/time-lint.mjs"]
}
