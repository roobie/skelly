// A manual teaches its recipes and is titled with its own name.
local book(id, name, weight, readingGameMinutes, recipes, text) = {
  id: id,
  name: name,
  category: 'book',
  weight: weight,
  size: [2, 2],
  model: 'notebook',
  book: { title: name, recipes: recipes, readingGameMinutes: readingGameMinutes },
  readable: { title: name, text: text },
};

(import 'tools/jsonnet/lib/item-policy.libsonnet').itemPack({
  items: [
    book(
      'field_manual',
      'Field Manual: Making Do',
      400,
      20,
      [
        'strip_wire',
        'field_patch',
        'make_electrical_repair_kit',
        'make_taped_flashlight_mount',
        'make_improvised_suppressor',
      ],
      'A pocket guide to salvaging useful material from damaged equipment.',
    ),
    book(
      'camp_craft_manual',
      'Camp Craft',
      350,
      15,
      [
        'torch',
        'candle',
        'rag_to_cloth_strip',
        'trim_wood_offcut',
        'assemble_fastener_pack',
        'make_scrap_foregrip',
        'make_bandage',
        'make_headlamp_strap',
        'make_weapon_sling',
      ],
      'Notes on making simple light and shelter from things found nearby.',
    ),
    book(
      'home_repair_manual',
      'Home Repair Handbook',
      500,
      25,
      [
        'repair_kit',
        'make_sewing_kit',
        'make_sewing_repair_kit',
        'sew_cloth_strip',
        'repair_crowbar',
        'repair_hammer',
        'repair_brick',
        'repair_planks',
        'repair_machete',
        'repair_kabar',
        'repair_baseball_bat',
        'repair_steel_pipe',
        'repair_jeans',
        'repair_cargo_pants',
        'repair_hoodie',
        'repair_jacket',
        'repair_utility_vest',
        'repair_stab_vest',
        'repair_riot_helmet',
        'repair_hiking_backpack',
        'repair_fanny_pack',
        'repair_flashlight',
      ],
      'A practical handbook for keeping tools and household goods working.',
    ),
    book(
      'workshop_manual',
      'Workshop Notes',
      300,
      30,
      [
        'field_patch',
        'make_wire_strippers',
        'make_electrical_repair_kit',
        'assemble_fastener_pack',
        'make_taped_flashlight_mount',
        'make_improvised_suppressor',
        'make_scrap_foregrip',
        'make_nail_bat',
        'make_spear',
        'make_taped_armour',
        'make_weapon_sling',
      ],
      'Handwritten notes on careful repairs and using salvaged wire.',
    ),
  ],
})
