// Batteries, medicine, materials, books, ammunition and severed parts.

// One pill is one item, so a found pack is a stack of them; loot.jsonnet sizes its pill counts from this.
local pillPack = 24;

// A book teaches its recipes and is titled with its own name.
local book(id, name, weight, readingGameMinutes, recipes, text) = {
  id: id,
  name: name,
  category: 'book',
  weight: weight,
  size: [2, 2],
  model: 'notebook',
  book: { title: name, recipes: recipes, readingGameMinutes: readingGameMinutes },
  readable: { title: name, text: text },
};

// Fired cases and hulls pile up in the thousands and scatter where they land.
local spentCase(id, name, weight, description, model) = {
  id: id,
  name: name,
  category: 'material',
  weight: weight,
  size: [1, 1],
  stack: 10000,
  description: description,
  pileDisplay: 'scatter',
  model: model,
};

