// Tools, melee weapons and carried lights.

// Disassembly recovers a rolled share of each part, rounded down.
local salvage = [0.5, 0.6, 0.7, 0.8, 0.9, 1];
local yield(item, count) = { item: item, count: count, fractions: salvage, rounding: 'floor' };
local disassembly(timeGameMinutes, yields) = { timeGameMinutes: timeGameMinutes, skill: 'crafting', yields: yields };

local melee(type, motion, damage, reach, cooldownSimSeconds, stamina, impulse, wearPerHit) = {
  melee: {
    damage: damage,
    reach: reach,
    cooldownSimSeconds: cooldownSimSeconds,
    stamina: stamina,
    impulse: impulse,
    wearPerHit: wearPerHit,
    contactFraction: 0.4,
    windupCapSimSeconds: 0.25,
    type: type,
    motion: motion,
    // Provisional until #276 is tuned: a full charge costs one more swing's stamina.
    charge: {
      fullSimSeconds: 1,
      curveExponent: 1,
      damageMultiplier: 1.6,
      impulseMultiplier: 2,
      stamina: stamina,
    },
  },
};

// A weapon without these keeps the shared swing and hit (`DESIGN.md`, "Weapon sounds").
local lightSwing = { melee+: { swingSound: 'melee_swing_light' } };
local heavySwing = { melee+: { swingSound: 'melee_swing_heavy' } };
local metalRing = { melee+: { hitLayerSound: 'melee_hit_metal' } };

local lights = import 'lights.libsonnet';
local batteryBeam = lights.batteryBeam;

local burns(ignition, douse, sprint, stow, drop, relight) = {
  ignition: ignition,
  douse: douse,
  sprint: sprint,
  stow: stow,
  drop: drop,
  relight: relight,
};

local meleeClasses = [
  { id: 'blunt', damageVariance: 0.05, headDamageMultiplier: 1.7, limbDamageMultiplier: 1, speedMultiplier: 0.85 },
  { id: 'cut', damageVariance: 0.18, headDamageMultiplier: 1, limbDamageMultiplier: 2.5, speedMultiplier: 1 },
  { id: 'pierce', damageVariance: 0.4, headDamageMultiplier: 1, limbDamageMultiplier: 1, speedMultiplier: 1.15 },
  {
    id: 'fists',
    capability: 'unarmed',
    damageVariance: 0,
    headDamageMultiplier: 1,
    limbDamageMultiplier: 1,
    speedMultiplier: 1,
    unarmed: { motion: 'swing', damage: 8, reach: 0.1, cooldownSimSeconds: 0.8, stamina: 4, impulse: 4, contactFraction: 0.4, windupCapSimSeconds: 0.25 },
  },
];

