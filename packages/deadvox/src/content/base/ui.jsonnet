{
  ui: [{
    id: 'core',
    spacing: 1,
    hudScale: 1,
    furnitureRadial: {
      radiusPixels: 110,
      deadZonePixels: 30,
      strokePixels: 3,
      selectedLabelScale: 1.25,
      labelPaddingRem: 0.5,
      labelRadiusRem: 0.375,
      entryCap: 8,
      slots: { push: 0, drag: 180, lift: 270, repair: 90, continue: 135 },
    },
    refusalSound: 'player_nope',
    audioVolumes: { master: 0.8, world: 0.8, body: 0.8, ui: 0.8 },
    restLabels: { rest: 'Resting', sleep: 'Sleeping' },
    doorCloseBlockedMessages: { player: "You're in the way", other: "Something's in the way" },
    furnitureMoveMessages: {
      tooBig: "It's too big for me to lift",
      carryInstead: 'I can carry it instead',
      floorOnly: "I need a level floor under it",
      slideTired: "I'm too tired to move it",
      fastened: "It's fixed in place",
      handsFull: 'My hands are full',
      tired: "I'm too tired to lift it",
      standingOn: "I'm standing on it",
      someoneOnIt: "Someone's standing on it",
      holdsUp: "Something's resting on it",
      holdsItems: "There's still something in it",
      barricaded: "Something's in the doorway",
      reserved: "I'm taking it apart",
      fallsOnPlayer: "What's on top would fall on me",
      fallsOnOther: "What's on top would fall on someone",
      nowhereToLand: "There's nowhere for what's on it to land",
      noRoom: "There's no room for it there",
      playerInWay: "I'm in the way",
      otherInWay: "Someone's in the way",
      coversHatch: 'It would cover the hatch',
      hatchCovered: "Something's lying on it",
      blocksLadder: 'It would block the ladder',
      outOfReach: "I can't reach there",
      wornOut: "I can't hold it any longer",
      emptyHands: "I'm not carrying anything",
      staysUpright: 'It has to stay upright',
    },
    actionText: import 'action-text.libsonnet',
    wearSlotLabels: {
      head: 'Head',
      eyes: 'Eyes',
      torso: 'Torso',
      vest: 'Vest',
      legs: 'Legs',
      back: 'Back',
      waist: 'Waist',
      hands: 'Hands',
      feet: 'Feet',
      shoulder: 'Shoulder',
    },
    screenText: import 'ui-screen-text.libsonnet',
  } + import 'ui-core-text.libsonnet'],
}
