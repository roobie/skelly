    one('compression.continue', 'Enter'),
  ] + digits('quickbar.use', 5) + digits('quickbar.assign', 5) + [
    many('inventory.previous', ['ArrowUp', 'ArrowLeft']),
    many('inventory.next', ['ArrowDown', 'ArrowRight']),
    one('inventory.search', 'KeyS'),
    one('inventory.cycle-target', 'KeyC'),
    one('inventory.put-target', 'KeyP'),
    one('inventory.find', 'KeyF'),
    one('inventory.hands', 'KeyW'),
    one('inventory.wear', 'KeyY'),
    one('inventory.drop', 'KeyD'),
    one('inventory.rotate', 'KeyR'),
    one('inventory.best-pocket', 'Enter'),
    one('inventory.take-all-like', 'KeyA'),
    one('inventory.quick-action-gate', 'KeyT'),
    one('inventory.view-item', 'Mouse1'),
    one('reading.close', 'Tab'),
    one('reading.line-up', 'ArrowUp'),
    one('reading.line-down', 'ArrowDown'),
    one('reading.page-up', 'PageUp'),
    many('reading.page-down', ['PageDown', 'Space']),
    one('reading.first', 'Home'),
