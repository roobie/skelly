// Default keys per action id (`CONTROLS.md`, "Ownership"). Actions, contexts, gestures and gates
// stay in code so replay stays stable; a player's stored rebind overrides these by action id.
local key(code) = { code: code };
local shifted(code) = { code: code, modifier: 'shift' };
local one(id, code) = { id: id, keys: [key(code)] };
local many(id, codes) = { id: id, keys: [key(code) for code in codes] };
local digits(prefix, count) = [one(prefix + '.' + i, 'Digit' + i) for i in std.range(1, count)];

{
  controls: [
    one('stance.ready', 'Mouse2'),
    one('aim.ads-toggle', 'Mouse1'),
    one('movement.forward', 'KeyW'),
    one('movement.back', 'KeyS'),
    one('movement.left', 'KeyA'),
    one('movement.right', 'KeyD'),
    many('movement.sprint', ['ShiftLeft', 'ShiftRight']),
    one('movement.walk-toggle', 'KeyZ'),
    one('player.crouch-toggle', 'KeyC'),
    one('player.prone-toggle', 'KeyN'),
    one('player.throw', 'KeyT'),
    one('movement.jump', 'Space'),
    one('carry.tip', 'KeyR'),
    one('carry.turn', 'KeyT'),
    one('noclip.ascend', 'Space'),
    one('noclip.descend', 'KeyC'),
    one('hand.use-off', 'Equal'),
    one('light.worn-toggle', 'KeyL'),
    one('world.interact', 'KeyF'),
