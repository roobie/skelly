// Items for the parts real vehicles share (`packages/thing-authoring-tool/vehicles/shared.libsonnet`).
local kit = import '../vehicle-kit.libsonnet';
local part = kit.part;
local pile = kit.pileSize;
// A wheel mounts to any hub of its own class, so each size is its own mount.
local wheel(id, name) = part(id, 'Wheel ' + name, [6, 6], ['wheel']) + { vehicle+: { mount: id } };
